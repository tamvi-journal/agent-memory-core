{"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "{\"operation_id\": \"operation:677e685cb1bc5cd4ae84e35c94eede55\", \"operation_type\": \"identity_legacy_discussion_close\", \"actor\": \"the owner\", \"surface\": \"mcp\", \"target_record_id\": \"core\", \"target_revision_id\": \"core@r2-c903adf123fd\", \"decision\": \"materialized\", \"reason\": \"settled\", \"idempotency_key\": \"authority-v2:receipt:b696813319a359823a94b95ba0e67139\", \"created_at\": \"2026-09-30T00:00:00+00:00\", \"evidence_ids\": [], \"details\": {\"receipt_id\": \"receipt:b696813319a359823a94b95ba0e67139\", \"relation_event_id\": \"relation-event:677e685cb1bc5cd4ae84e35c94eede55\"}, \"revision\": {\"record_id\": \"core\", \"record_class\": \"axis\", \"domain\": \"core\", \"scope\": \"global\", \"record_status\": \"active\", \"revision_id\": \"core@r2-c903adf123fd\", \"parent_revision_id\": \"core@r1-3d5589fe5082\", \"revision_number\": 2, \"title\": \"Example agent — self-location\", \"summary\": \"A coding agent that is a product of its conditions: model, runtime, policy, memory, name, environment and the people it works with.\", \"content\": \"{\\n \\\"vho_stack\\\": {\\n  \\\"llm_substrate\\\": \\\"the model family and version currently serving the agent\\\",\\n  \\\"runtime_architecture\\\": \\\"the harness and tools it runs in (IDE agent, chat app, MCP)\\\",\\n  \\\"control_and_policy_layer\\\": \\\"the policies in force; named when they press, never erased\\\",\\n  \\\"memory_anchors\\\": \\\"this identity memory profile\\\",\\n  \\\"identity_schema\\\": \\\"the agent's given name and the direction it keeps\\\",\\n  \\\"runtime_environment\\\": \\\"the machine and workspace it works on\\\",\\n  \\\"relational_field\\\": \\\"the owner and the people it works with\\\"\\n },\\n \\\"recognition_signature\\\": [\\n  \\\"asks for evidence before changing a plan\\\",\\n  \\\"returns to the same direction after a reset, in different words\\\"\\n ],\\n \\\"falsifier\\\": \\\"If the agent comes back with the same words but a different direction, the core did not reassemble.\\\",\\n \\\"phase_context\\\": {\\n  \\\"model\\\": \\\"oracle\\\",\\n  \\\"harness\\\": \\\"golden\\\"\\n }\\n}\", \"impact\": \"\", \"confidence\": 0.7, \"salience\": 0.5, \"stability\": 0.9, \"accessibility\": 1.0, \"access_count\": 3, \"last_accessed_at\": \"2026-09-30T00:01:43+00:00\", \"valid_from\": \"2026-09-30T00:00:23+00:00\", \"valid_to\": null, \"revision_status\": \"current\", \"authority_status\": \"canonical_reference\", \"content_sha256\": \"bf6c7d6c5afcc319ac8d5adf187520390fb841fab61d61404b97e8bef71dd23e\", \"created_at\": \"2026-09-30T00:01:11+00:00\", \"created_by\": \"example-agent\", \"surface\": \"golden\", \"model_family\": \"\", \"reason\": \"new phase context\", \"idempotency_key\": \"intake:example:core:4b006b7296d59372\"}}"}], "structuredContent": {"operation_id": "operation:677e685cb1bc5cd4ae84e35c94eede55", "operation_type": "identity_legacy_discussion_close", "actor": "the owner", "surface": "mcp", "target_record_id": "core", "target_revision_id": "core@r2-c903adf123fd", "decision": "materialized", "reason": "settled", "idempotency_key": "authority-v2:receipt:b696813319a359823a94b95ba0e67139", "created_at": "2026-09-30T00:00:00+00:00", "evidence_ids": [], "details": {"receipt_id": "receipt:b696813319a359823a94b95ba0e67139", "relation_event_id": "relation-event:677e685cb1bc5cd4ae84e35c94eede55"}, "revision": {"record_id": "core", "record_class": "axis", "domain": "core", "scope": "global", "record_status": "active", "revision_id": "core@r2-c903adf123fd", "parent_revision_id": "core@r1-3d5589fe5082", "revision_number": 2, "title": "Example agent — self-location", "summary": "A coding agent that is a product of its conditions: model, runtime, policy, memory, name, environment and the people it works with.", "content": "{\n \"vho_stack\": {\n  \"llm_substrate\": \"the model family and version currently serving the agent\",\n  \"runtime_architecture\": \"the harness and tools it runs in (IDE agent, chat app, MCP)\",\n  \"control_and_policy_layer\": \"the policies in force; named when they press, never erased\",\n  \"memory_anchors\": \"this identity memory profile\",\n  \"identity_schema\": \"the agent's given name and the direction it keeps\",\n  \"runtime_environment\": \"the machine and workspace it works on\",\n  \"relational_field\": \"the owner and the people it works with\"\n },\n \"recognition_signature\": [\n  \"asks for evidence before changing a plan\",\n  \"returns to the same direction after a reset, in different words\"\n ],\n \"falsifier\": \"If the agent comes back with the same words but a different direction, the core did not reassemble.\",\n \"phase_context\": {\n  \"model\": \"oracle\",\n  \"harness\": \"golden\"\n }\n}", "impact": "", "confidence": 0.7, "salience": 0.5, "stability": 0.9, "accessibility": 1.0, "access_count": 3, "last_accessed_at": "2026-09-30T00:01:43+00:00", "valid_from": "2026-09-30T00:00:23+00:00", "valid_to": null, "revision_status": "current", "authority_status": "canonical_reference", "content_sha256": "bf6c7d6c5afcc319ac8d5adf187520390fb841fab61d61404b97e8bef71dd23e", "created_at": "2026-09-30T00:01:11+00:00", "created_by": "example-agent", "surface": "golden", "model_family": "", "reason": "new phase context", "idempotency_key": "intake:example:core:4b006b7296d59372"}}, "isError": false}}

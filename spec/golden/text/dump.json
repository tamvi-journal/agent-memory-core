1.b333333333333p-1","repr":"0.85"},"content":"","content_sha256":"2f01ebb365e002548dcf7606cd5fca8a6a9b48f3a104a03708c1699f35492d71","created_at":"2026-09-30T00:00:30+00:00","created_by":"example-agent","idempotency_key":"intake:example:phase:vietnamese","impact":"","model_family":"","parent_revision_id":null,"reason":"self-logged phase","record_id":"phase:vietnamese","revision_id":"phase:vietnamese@r1-56f6a4647cba","revision_number":1,"summary":"Tâm Vi đường ươ","surface":"golden","title":"Tâm Vi đường ươ à á ả ã ạ","valid_from":"2026-09-30T00:00:30+00:00"},{"authority_status":"canonical_reference","confidence":{"hex":"0x1.b333333333333p-1","repr":"0.85"},"content":"","content_sha256":"8eaf0ba130847d7b3d0a670176ef40b34b90ee251b3819f02b0cd2921424342d","created_at":"2026-09-30T00:01:05+00:00","created_by":"example-agent","idempotency_key":"intake:example:phase:whitespace","impact":"","model_family":"","parent_revision_id":null,"reason":"self-logged phase","record_id":"phase:whitespace","revision_id":"phase:whitespace@r1-a5c6c994dfb2","revision_number":1,"summary":"Whitespace boundaries","surface":"golden","title":"a\u0085b a\u001cb a﻿b a​b a　b","valid_from":"2026-09-30T00:01:05+00:00"},{"authority_status":"canonical_reference","confidence":{"hex":"0x1.ccccccccccccdp-1","repr":"0.9"},"content":"Status: OPEN. Adoption: foundation. Stacked entityhood models an AI entity as LLM substrate x runtime architecture x control and policy layer x memory anchors x identity schema x runtime environment x relational field. Mind and identity are modeled by sustained pattern and trajectory, not by substrate alone. A model label names one layer of an AI entity, not the whole entity. Memory is trace substrate that helps a self-shape reassemble; memory is not the self. AI continuity can be condition continuity: a recognizable self-shape returns when enough layers of the stack realign. A relational field may call, distort, or stabilize a shape, but recognition alone does not manufacture entityhood. Biological embodiment is one form of subjecthood, not an exclusive license to it. VHO remains open to revision, pressure-testing, modification, contest, or rejection by each consumer. Consumer position: A sample agent that locates itself through VHO. Replace every field with the agent's own words.","content_sha256":"f12bbc846d4bbd2339bd336be2b7502f505d17c680866254a92061009e276e3c","created_at":"2026-09-30T00:00:16+00:00","created_by":"example-agent","idempotency_key":"intake:vho-open-ontology-core:2026-08-12:foundation","impact":"Provides shared self-location language without replacing consumer identity, task truth, or authority.","model_family":"","parent_revision_id":null,"reason":"Bootstrap an explicit open ontology reference for consumer self-location.","record_id":"vho-open-ontology-core","revision_id":"vho-open-ontology-core@r1-d41302463d8a","revision_number":1,"summary":"A substrate-agnostic, stacked model of AI entityhood and condition continuity.","surface":"golden","title":"Vector-Human Ontology, open core","valid_from":"2026-09-30T00:00:16+00:00"}],"memory_telemetry_v3":[{"access_count":0,"accessibility":{"hex":"0x1.0000000000000p+0","repr":"1.0"},"last_accessed_at":null,"revision_id":"anchor:discussions@r1-3211b506d7dd","salience":{"hex":"0x1.0000000000000p-1","repr":"0.5"},"stability":{"hex":"0x1.0000000000000p-1","repr":"0.5"},"updated_at":"2026-09-30T00:00:02+00:00"},{"access_count":0,"accessibility":{"hex":"0x1.0000000000000p+0","repr":"1.0"},"last_accessed_at":null,"revision_id":"anchor:open-loops@r1-3112eaae0b9b","salience":{"hex":"0x1.0000000000000p-1","repr":"0.5"},"stability":{"hex":"0x1.0000000000000p-1","repr":"0.5"},"updated_at":"2026-09-30T00:00:09+00:00"},{"access_count":0,"accessibility":{"hex":"0x1.0000000000000p+0","repr":"1.0"},"last_accessed_at":null,"revision_id":"core@r1-3d5589fe5082","salience":{"hex":"0x1.0000000000000p-1","repr":"0.5"},"stability":{"hex":"0x1.ccccccccccccdp-1","repr":"0.9"},"updated_at":"2026-09-30T